# EchoMe configuration — copy to `.env` and fill in.
# `.env` is gitignored; never commit real keys. The LLM provider is pluggable:
# switch providers by changing PROVIDER alone — no code change.

# Which LLM brain to use: "ollama" (free, local dev) | "openai" | "claude"
PROVIDER=openai

# --- Ollama (free, local dev) ---
OLLAMA_MODEL=llama3.1
OLLAMA_URL=http://localhost:11434

# --- OpenAI (paid API) ---
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o-mini

# --- Claude (paid API, production) ---
# Get a key at https://console.anthropic.com/ — leave blank unless PROVIDER=claude.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- Embeddings (local, used for RAG regardless of provider) ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Speech-to-text (Phase 2; downloaded on first use of `voice_chat`) ---
# Whisper size: tiny | base | small | medium  (base is a good M-series default)
WHISPER_MODEL=base
# CPU compute type: int8 (fast) | int8_float16 | float32
WHISPER_COMPUTE_TYPE=int8

# --- Text-to-speech (Phase 3; downloaded on first use of `voice_chat`) ---
# Pluggable engine:
#   luxtts     = local/non-commercial only (ZipVoice/Emilia weights)
#   chatterbox = MIT code + MIT weights, shippable (needs the separate venv-chatterbox)
TTS_ENGINE=luxtts
# Reference clip to clone the voice from (gitignored personal data).
# The clip must contain spoken consent ("This is my voice, and I give permission to use
# it.") — verified with Whisper and logged before any cloning. See `python -m echome.consent`.
VOICE_REF=voice/voice_sample.wav
# Watermark all synthesized audio as AI-generated (AudioSeal, 16 kHz output). Keep this
# ON for anything shared — it's how a cloned-voice clip can be proven synthetic. Verify
# any clip with `python -m echome.watermark <file.wav>`.
TTS_WATERMARK=true
# End-of-generation drift mitigations (LuxTTS):
TTS_SMOOTH=true            # return_smooth: smoother vocoder path, fewer end artifacts
TTS_RUNWAY_TEXT=" ."       # appended to text so drift lands on throwaway runway (empty = off)
TTS_END_TRIM_MS=0          # trim N ms off the end of the audio (try 120 if drift persists)

# Where the vector index is written (gitignored).
INDEX_DIR=index

# Retrieval relevance floor (cosine similarity, 0-1). Chunks below this are dropped;
# if nothing clears it, the twin says it doesn't know rather than guessing. Tune this.
MIN_SIMILARITY=0.25
